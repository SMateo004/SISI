  "info": {
    "title": "SISI API",
    "description": "API de SISI: servicios inmediatos (Bolivia). Los errores tienen la forma {statusCode, code, message} con mensajes en español.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          },
          "version": {
            "type": "string",
            "description": "Versión reportada (solo PostGIS)",
            "example": "3.5.2"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthCheckDto"
          },
          "postgis": {
            "$ref": "#/components/schemas/HealthCheckDto"
          },
          "redis": {
            "$ref": "#/components/schemas/HealthCheckDto"
          }
        },
        "required": [
          "database",
          "postgis",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-13T21:00:00.000Z"
          }
        },
        "required": [
          "status",
          "checks",
          "timestamp"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "OTP_INVALID",
            "description": "Código estable para la app"
          },
          "message": {
            "type": "string",
            "example": "Código incorrecto o vencido."
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "7b0a1c7e-5f1e-4c41-9a51-0f8e7f1f5a10"
          },
          "phone": {
            "type": "string",
            "example": "+59170012345"
          },
          "name": {
            "type": "string",
            "example": "María Pérez",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "example": "https://...firmada...",
            "nullable": true,
            "description": "URL temporal de la foto de perfil"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "example": "user"
          },
          "activeMode": {
            "type": "string",
            "enum": [
              "employer",
              "worker"
            ],
            "example": "employer"
          },
          "cityId": {
            "type": "string",
            "example": "b1f0e1a2-3c4d-4e5f-8a9b-0c1d2e3f4a5b"
          },
