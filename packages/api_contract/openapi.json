{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Estado de la API, la base de datos (con PostGIS) y Redis",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "SISI API",
    "description": "API de SISI: servicios inmediatos (Bolivia).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          },
          "version": {
            "type": "string",
            "description": "Versión reportada (solo PostGIS)",
            "example": "3.5.2"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthCheckDto"
          },
          "postgis": {
            "$ref": "#/components/schemas/HealthCheckDto"
          },
          "redis": {
            "$ref": "#/components/schemas/HealthCheckDto"
          }
        },
        "required": [
          "database",
          "postgis",
          "redis"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-13T21:00:00.000Z"
          }
        },
        "required": [
          "status",
          "checks",
          "timestamp"
        ]
      }
    }
  }
}
