# Flutter NO lee este archivo: es la referencia de los --dart-define por ambiente.
# Local (web):      flutter run -d chrome --web-port 8080
# Emulador Android: flutter run --dart-define=API_URL=http://10.0.2.2:3000 --dart-define=SOCKET_URL=http://10.0.2.2:3000
# Build:            flutter build web --release --dart-define=API_URL=... --dart-define=SOCKET_URL=... --dart-define=APP_ENV=staging

API_URL=http://localhost:3000
SOCKET_URL=http://localhost:3000
APP_ENV=local
