# Copia este archivo a .env (no se sube al repo). Valores para desarrollo local.
# Ver docs/02-contexto-tecnico-claude-code.md §11 y docs/adr/0002.

NODE_ENV=development
PORT=3000

# infra/docker-compose.yml
DATABASE_URL=postgresql://sisi:sisi@localhost:55432/sisi
REDIS_URL=redis://localhost:56379

# Mínimo 32 caracteres. En Render se generan solos.
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-jwt-0001
JWT_REFRESH_SECRET=solo-desarrollo-cambiar-este-secreto-refresh-0001

# Opcionales hasta su fase (dejar vacíos en local).
OTP_PROVIDER_KEY=
FIREBASE_SERVICE_ACCOUNT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAPS_API_KEY=
SENTRY_DSN=

# Orígenes web permitidos, separados por coma (app web en 8080 y admin en 8081 en local).
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

TZ_DEFAULT=America/La_Paz
