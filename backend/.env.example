# Copia este archivo a .env (no se sube al repo). Valores para desarrollo local.
# Ver docs/02-contexto-tecnico-claude-code.md §11 y docs/adr/0002.

NODE_ENV=development
# local | test | staging | production. Obligatorio si NODE_ENV=production (ADR-0011).
APP_ENV=local
PORT=3000

# infra/docker-compose.yml
DATABASE_URL=postgresql://sisi:sisi@localhost:15432/sisi
REDIS_URL=redis://localhost:16379

# --- JWT (ADR-0009). Mínimo 32 caracteres. En Render se generan solos. ---
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-jwt-0001
JWT_REFRESH_SECRET=solo-desarrollo-cambiar-este-secreto-refresh-0001
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- OTP (ADR-0011) ---
# console: imprime el código en el log (solo local, test y staging).
# bird: SMS real con Bird.com (obligatorio en production).
OTP_PROVIDER=console
# Clave de API de Bird (bk_us1_... o bk_eu1_...) y remitente del SMS.
OTP_PROVIDER_KEY=
OTP_SENDER=
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
# Prefijos de país permitidos, sin "+", separados por coma. MVP: solo Bolivia.
PHONE_ALLOWED_COUNTRY_CODES=591

# --- Rate limits (ADR-0010; propuesta en docs/pendientes.md) ---
RATE_GLOBAL_IP_PER_MIN=300
RATE_OTP_PHONE_COOLDOWN_SEC=60
RATE_OTP_PHONE_PER_HOUR=5
RATE_OTP_PHONE_PER_DAY=10
RATE_OTP_IP_PER_HOUR=20
RATE_OTP_VERIFY_IP_PER_15MIN=30
RATE_AUTH_IP_PER_MIN=30

# --- Almacenamiento S3 (ADR-0012). Local: RustFS de infra/docker-compose.yml. ---
# Producción: Cloudflare R2 (https://<account_id>.r2.cloudflarestorage.com, región auto).
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET=sisi-local
STORAGE_ACCESS_KEY=sisi-local
STORAGE_SECRET_KEY=sisi-local-secret
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_TTL_SEC=300
DOCUMENT_URL_TTL_SEC=300
AVATAR_URL_TTL_SEC=3600

DEFAULT_CITY_SLUG=santa-cruz

# --- Solicitudes (ADR-0019; propuesta en docs/pendientes.md) ---
REQUEST_DESCRIPTION_MIN=20
REQUEST_DESCRIPTION_MAX=1000
REQUEST_MAX_PHOTOS=4
REQUEST_PHOTO_URL_TTL_SEC=3600
RATE_REQUEST_PUBLISH_PER_HOUR=10
RATE_REQUEST_PUBLISH_PER_DAY=30
RATE_REQUEST_CREATE_IP_PER_HOUR=30

# --- Mapas (ADR-0021) ---
# fake: dirección de prueba (local, test y staging). google: Geocoding API (obligatorio en production).
GEOCODING_PROVIDER=fake
# Llave de servidor de Google Maps, restringida a la Geocoding API. Nunca va a la app.
MAPS_API_KEY=
RATE_GEOCODE_IP_PER_MIN=60

# --- Outbox y colas BullMQ (ADR-0022) ---
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
QUEUE_PREFIX=bull
QUEUE_KEEP_COMPLETED_SEC=86400
MATCHING_RECONCILE_MS=60000

# --- Matching por anillos (R4, ADR-0025; propuesta en docs/pendientes.md) ---
# km:límite por anillo (anillo 1: 5 más cercanos a 2 km; 2 y 3: hasta 10 a 5 y 10 km).
MATCHING_RINGS=2:5,5:10,10:10
MATCHING_RING_WAIT_MS=45000
MATCHING_ENOUGH_OFFERS=3
MATCHING_OFFERS_GRACE_MS=600000
# Tiempo mínimo de búsqueda aunque no haya candidatos, y cada cuánto se reintenta.
MATCHING_MIN_SEARCH_MS=180000
MATCHING_RESCAN_MS=45000

# --- Ofertas (R5, ADR-0026; propuesta en docs/pendientes.md) ---
ETA_SPEEDS_KMH=a_pie:4.5,bicicleta:12,moto:25,auto:20,transporte_publico:15
ETA_ROUTE_FACTOR=1.3
OFFER_COUNTER_MAX_FACTOR=3
RATE_OFFER_PER_MIN=10
RATE_OFFER_IP_PER_MIN=60

# --- Ubicación del trabajador (ADR-0024; propuesta en docs/pendientes.md) ---
WORKER_LOCATION_PERSIST_MS=30000
WORKER_LOCATION_PERSIST_M=100
WORKER_LOCATION_STALE_MS=600000
LOCATION_SWEEP_MS=60000
RATE_WORKER_LOCATION_PER_MIN=30

# --- Push (ADR-0027) ---
# fake: solo log (local, test y staging sin Firebase). fcm: obligatorio en production.
PUSH_PROVIDER=fake
# Cuenta de servicio de Firebase (JSON en una línea o en base64). Secreto: nunca en git.
FIREBASE_SERVICE_ACCOUNT=

# Opcional hasta su fase (dejar vacío en local).
SENTRY_DSN=

# Orígenes web permitidos, separados por coma (app web en 8080 y admin en 8081 en local).
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

TZ_DEFAULT=America/La_Paz
