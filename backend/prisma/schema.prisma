// Esquema de datos de SISI. Ver docs/02-contexto-tecnico-claude-code.md §4 y ADR-0003.
// Nombres en BD en snake_case; montos en Decimal; fechas en UTC (timestamptz).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Ciudades donde opera la plataforma (R10.1: toda entidad relevante lleva city_id).
model City {
  id              String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String                                  @unique
  name            String
  /// Código de país ISO 3166-1 alfa-2 (BO).
  countryCode     String                                  @map("country_code") @db.Char(2)
  /// Zona horaria IANA (America/La_Paz).
  timezone        String
  active          Boolean                                 @default(true)
  /// Centro de la ciudad (validación de ubicación por radio; ADR-0019). Se lee y escribe con SQL.
  center          Unsupported("geography(Point,4326)")?
  /// Radio de servicio en km desde el centro (provisional: zonas exactas pendientes).
  serviceRadiusKm Decimal?                                @map("service_radius_km") @db.Decimal(5, 2)
  /// Área de servicio opcional; si existe tiene prioridad sobre el radio.
  serviceArea     Unsupported("geography(Polygon,4326)")? @map("service_area")
  createdAt       DateTime                                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  categories      CategoryCity[]
  featureFlags    FeatureFlag[]
  requests        ServiceRequest[]
  workerLocations WorkerLocation[]
  notifications   Notification[]
  adminAuditLog   AdminAuditLog[]

  @@map("cities")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

/// Modo activo de la cuenta (R1.2: toda cuenta nueva empieza como employer).
enum ActiveMode {
  employer
  worker

  @@map("active_mode")
}

/// Una cuenta por persona, identificada por su teléfono en E.164 (R1.1).
model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone               String     @unique
  name                String?
  /// Clave del objeto en el almacenamiento (avatars/...); la URL se firma al responder.
  photoKey            String?    @map("photo_key")
  role                UserRole   @default(user)
  activeMode          ActiveMode @default(employer) @map("active_mode")
  cityId              String     @map("city_id") @db.Uuid
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// Promedio como empleador (lo ven los trabajadores en las solicitudes entrantes, ADR-0032).
  employerRatingAvg   Decimal    @default(0) @map("employer_rating_avg") @db.Decimal(3, 2)
  employerRatingCount Int        @default(0) @map("employer_rating_count")
  /// 3 reportes válidos sin ser trabajador aprobado: aviso para el admin (ADR-0033).
  moderationFlaggedAt DateTime?  @map("moderation_flagged_at") @db.Timestamptz(3)
  /// Trabajos que canceló (sin penalidad por ahora, Fase 4).
  cancellationsCount  Int        @default(0) @map("cancellations_count")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  city                   City                @relation(fields: [cityId], references: [id])
  refreshTokens          RefreshToken[]
  workerProfile          WorkerProfile?      @relation("WorkerProfileUser")
  reviewedWorkerProfiles WorkerProfile[]     @relation("WorkerProfileReviewer")
  reviewedDocuments      WorkerDocument[]    @relation("WorkerDocumentReviewer")
  workerStatusEvents     WorkerStatusEvent[] @relation("WorkerStatusEventActor")
  serviceRequests        ServiceRequest[]    @relation("ServiceRequestEmployer")
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  jobsAsEmployer         Job[]               @relation("JobEmployer")
  jobsAsWorker           Job[]               @relation("JobWorker")
  adminAuditEntries      AdminAuditLog[]     @relation("AdminAuditLogAdmin")

  @@index([cityId])
  // Búsqueda del panel por nombre o teléfono con ILIKE (pg_trgm, Fase 6) y listado por alta.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_phone_trgm_idx")
  @@index([createdAt, id])
  @@map("users")
}

/// Refresh tokens rotativos (ADR-0009). Se guarda solo el hash; id = jti del JWT.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Todos los tokens de una misma sesión comparten familia; reutilizar uno revoca la familia.
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Lista cerrada de categorías administrada por la empresa (R2). Sin seed hasta la Fase 2.
model Category {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Identificador estable (la app elige el ícono por slug).
  slug              String   @unique
  name              String
  description       String?
  priceMinBs        Decimal  @map("price_min_bs") @db.Decimal(10, 2)
  priceMaxBs        Decimal  @map("price_max_bs") @db.Decimal(10, 2)
  commissionPct     Decimal  @default(13.00) @map("commission_pct") @db.Decimal(5, 2)
  /// Requisitos extra de verificación (lista de claves; Fase 2).
  extraRequirements Json     @default("[]") @map("extra_requirements")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workers  WorkerCategory[]
  cities   CategoryCity[]
  requests ServiceRequest[]

  @@map("categories")
}

/// Disponibilidad y valores por ciudad (R2.2, R10.1). null = usa el valor de la categoría.
/// Una categoría solo está activa en una ciudad si existe esta fila y active = true.
model CategoryCity {
  categoryId    String   @map("category_id") @db.Uuid
  cityId        String   @map("city_id") @db.Uuid
  active        Boolean  @default(true)
  priceMinBs    Decimal? @map("price_min_bs") @db.Decimal(10, 2)
  priceMaxBs    Decimal? @map("price_max_bs") @db.Decimal(10, 2)
  commissionPct Decimal? @map("commission_pct") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([categoryId, cityId])
  @@index([cityId])
  @@map("category_cities")
}

/// Estados del perfil de trabajador, exactamente los de R1.4 (lista cerrada).
enum WorkerStatus {
  sin_solicitar
  pendiente_revision
  aprobado
  rechazado
  bloqueado_deuda
  suspendido_moderacion

  @@map("worker_status")
}

/// Medio de transporte (propuesta aprobada para el MVP, docs/pendientes.md).
enum TransportMode {
  a_pie
  bicicleta
  moto
  auto
  transporte_publico

  @@map("transport_mode")
}

enum WorkerDocumentType {
  ci_front
  ci_back
  selfie
  cert

  @@map("worker_document_type")
}

enum DocumentReviewStatus {
  pendiente
  aprobado
  rechazado

  @@map("document_review_status")
}

/// Perfil de trabajador (1:1 con users; la ciudad es la de la cuenta, R10.1).
model WorkerProfile {
  userId               String         @id @map("user_id") @db.Uuid
  status               WorkerStatus   @default(sin_solicitar)
  birthDate            DateTime?      @map("birth_date") @db.Date
  transport            TransportMode?
  /// Radio máximo de trabajo en km (propuesta: 1 a 10, validado en la API).
  maxRadiusKm          Int?           @map("max_radius_km") @db.SmallInt
  ratingAvg            Decimal        @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int            @default(0) @map("rating_count")
  /// Código corto y estable para la referencia de pago (base32 sin caracteres ambiguos, ADR-0035).
  billingCode          String?        @unique @map("billing_code") @db.VarChar(8)
  /// Cruzó el tope de deuda (R7.5): se avisa una sola vez hasta que baje (ADR-0038).
  debtCapReachedAt     DateTime?      @map("debt_cap_reached_at") @db.Timestamptz(3)
  /// Sin lógica en el MVP (niveles: etapa 2).
  level                Int            @default(1)
  submittedAt          DateTime?      @map("submitted_at") @db.Timestamptz(3)
  reviewedAt           DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewedById         String?        @map("reviewed_by") @db.Uuid
  rejectionReason      String?        @map("rejection_reason")
  /// Resolución de la última revisión de moderación (suspensión confirmada o levantada).
  moderationResolution String?        @map("moderation_resolution")
  statusChangedAt      DateTime       @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                  @relation("WorkerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                 @relation("WorkerProfileReviewer", fields: [reviewedById], references: [id])
  categories           WorkerCategory[]
  documents            WorkerDocument[]
  events               WorkerStatusEvent[]
  location             WorkerLocation?
  requestNotifications RequestNotification[]
  offers               Offer[]

  @@index([status])
  @@map("worker_profiles")
}

model WorkerCategory {
  workerId   String   @map("worker_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  worker   WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id])

  @@id([workerId, categoryId])
  @@index([categoryId])
  @@map("worker_categories")
}

/// Documentos de identidad (R9.5): solo la clave del objeto privado; nunca URLs públicas.
model WorkerDocument {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId     String               @map("worker_id") @db.Uuid
  type         WorkerDocumentType
  fileKey      String               @map("file_key")
  contentType  String               @map("content_type")
  sizeBytes    Int                  @map("size_bytes")
  reviewStatus DocumentReviewStatus @default(pendiente) @map("review_status")
  reviewedById String?              @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker     WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  reviewedBy User?         @relation("WorkerDocumentReviewer", fields: [reviewedById], references: [id])

  /// Un documento vigente por tipo.
  @@unique([workerId, type])
  @@map("worker_documents")
}

/// Historial de cambios de estado del trabajador (append-only): quién, cuándo y por qué.
model WorkerStatusEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId   String       @map("worker_id") @db.Uuid
  event      String
  fromStatus WorkerStatus @map("from_status")
  toStatus   WorkerStatus @map("to_status")
  reason     String?
  /// null = sistema (p. ej. billing-cron).
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  worker WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  actor  User?         @relation("WorkerStatusEventActor", fields: [actorId], references: [id])

  @@index([workerId, createdAt])
  @@map("worker_status_events")
}

/// Feature flags (R10.2). city_id null = valor global; una fila por ciudad lo sobreescribe.
model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  cityId      String?  @map("city_id") @db.Uuid
  enabled     Boolean  @default(false)
  description String?
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city City? @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([key, cityId])
  @@map("feature_flags")
}

enum ModerationTermKind {
  word
  regex

  @@map("moderation_term_kind")
}

/// Categorías de prohibición de R9.1.
enum ProhibitedCategory {
  sexual
  drogas
  armas
  ilegal
  inmoral
  venta_productos

  @@map("prohibited_category")
}

/// Términos o patrones del filtro de moderación (R3.3, R9.2, ADR-0018). Baja lógica con active=false.
model ModerationTerm {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term        String
  kind        ModerationTermKind
  category    ProhibitedCategory
  active      Boolean            @default(true)
  note        String?
  createdById String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([term, kind])
  @@map("moderation_terms")
}

/// Estados de una solicitud, exactamente los de R3.4 (ADR-0019).
enum ServiceRequestStatus {
  borrador
  retenida
  buscando
  con_ofertas
  asignada
  cancelada
  expirada

  @@map("service_request_status")
}

/// Solicitud de servicio (R3). geog se escribe y lee con SQL directo (PostGIS).
model ServiceRequest {
  id                String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerId        String                               @map("employer_id") @db.Uuid
  categoryId        String                               @map("category_id") @db.Uuid
  cityId            String                               @map("city_id") @db.Uuid
  description       String
  geog              Unsupported("geography(Point,4326)")
  address           String
  proposedPriceBs   Decimal                              @map("proposed_price_bs") @db.Decimal(10, 2)
  status            ServiceRequestStatus                 @default(borrador)
  /// Anillo de búsqueda actual (R4.2, ADR-0025). null = el matching aún no empezó.
  ring              Int?                                 @db.SmallInt
  /// Cuándo arrancó el anillo actual (los notificados tienen MATCHING_RING_WAIT_MS para ofertar).
  ringStartedAt     DateTime?                            @map("ring_started_at") @db.Timestamptz(3)
  /// Con ofertas sin elegir tras el último anillo: expira a esta hora (ADR-0025).
  expiresAt         DateTime?                            @map("expires_at") @db.Timestamptz(3)
  /// Cierres de la búsqueda programados (cada reintento del tiempo mínimo usa un job nuevo).
  closeSeq          Int                                  @default(0) @map("close_seq") @db.SmallInt
  /// Términos que coincidieron en moderación (solo para revisión del admin, R3.3).
  moderationMatches Json?                                @map("moderation_matches")
  reviewedById      String?                              @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?                            @map("reviewed_at") @db.Timestamptz(3)
  /// empleador | moderacion
  cancelReason      String?                              @map("cancel_reason")
  cancelNote        String?                              @map("cancel_note")
  publishedAt       DateTime?                            @map("published_at") @db.Timestamptz(3)
  cancelledAt       DateTime?                            @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer      User                  @relation("ServiceRequestEmployer", fields: [employerId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id])
  city          City                  @relation(fields: [cityId], references: [id])
  photos        ServiceRequestPhoto[]
  events        ServiceRequestEvent[]
  notifications RequestNotification[]
  offers        Offer[]
  job           Job?

  @@index([employerId, createdAt])
  @@index([status, cityId])
  @@index([geog], type: Gist)
  @@map("service_requests")
}

/// Fotos de una solicitud (máx. 4). Visibles para el empleador y, desde la Fase 3, los trabajadores notificados.
model ServiceRequestPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  fileKey     String   @map("file_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  position    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, position])
  @@index([requestId])
  @@map("service_request_photos")
}

/// Historial de estados de una solicitud (append-only).
model ServiceRequestEvent {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String                @map("request_id") @db.Uuid
  event      String
  fromStatus ServiceRequestStatus? @map("from_status")
  toStatus   ServiceRequestStatus  @map("to_status")
  reason     String?
  /// null = sistema.
  actorId    String?               @map("actor_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("service_request_events")
}

/// Outbox transaccional (ADR-0022): cada evento de dominio se escribe en la misma
/// transacción que el cambio de estado; el relay del proceso worker lo publica a BullMQ.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  /// Tipo del evento (p. ej. request.searching).
  type        String
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// No se publica antes de esta hora (reintentos con espera).
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, availableAt, id])
  @@index([aggregateId])
  @@map("outbox_events")
}

/// Ubicación y disponibilidad del trabajador (ADR-0024). La copia en vivo está en Redis GEO;
/// aquí se persiste con throttling y es la fuente de verdad para el matching (ADR-0025).
model WorkerLocation {
  workerId       String                                @id @map("worker_id") @db.Uuid
  cityId         String                                @map("city_id") @db.Uuid
  geog           Unsupported("geography(Point,4326)")?
  /// Toggle "Disponible": exige modo worker y perfil aprobado.
  available      Boolean                               @default(false)
  availableSince DateTime?                             @map("available_since") @db.Timestamptz(3)
  /// Última ubicación persistida. Sin actualizar en WORKER_LOCATION_STALE_MS = no disponible.
  locatedAt      DateTime?                             @map("located_at") @db.Timestamptz(3)
  updatedAt      DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker WorkerProfile @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  city   City          @relation(fields: [cityId], references: [id])

  @@index([geog], type: Gist)
  @@index([cityId, available])
  @@map("worker_locations")
}

/// Aviso a un usuario (ADR-0027): se guarda siempre y, si tiene dispositivos, va por push.
model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  cityId     String    @map("city_id") @db.Uuid
  /// request_new, offer_new, request_assigned, request_expired, request_released, request_rejected...
  type       String
  title      String
  body       String
  /// Datos para la app (ids y `route`, la pantalla a abrir al tocar el aviso).
  payload    Json      @default("{}")
  /// Evita duplicados si el job se reintenta: evento del outbox + destinatario.
  dedupeKey  String    @unique @map("dedupe_key")
  pushSentAt DateTime? @map("push_sent_at") @db.Timestamptz(3)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

enum DevicePlatform {
  android
  web
  ios

  @@map("device_platform")
}

/// Token de FCM de un dispositivo (ADR-0027). Los inválidos se borran al enviar.
model DeviceToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// A qué trabajador se le avisó de una solicitud, en qué anillo y cuándo (ADR-0025).
/// Sirve para no repetir avisos, para ver fotos y detalle (solo notificados) y para métricas.
model RequestNotification {
  requestId  String   @map("request_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  cityId     String   @map("city_id") @db.Uuid
  ring       Int      @db.SmallInt
  /// Distancia en línea recta al momento de avisar.
  distanceM  Int      @map("distance_m")
  notifiedAt DateTime @default(now()) @map("notified_at") @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  worker  WorkerProfile  @relation(fields: [workerId], references: [userId], onDelete: Cascade)

  @@id([requestId, workerId])
  @@index([workerId, notifiedAt])
  @@map("request_notifications")
}

enum OfferType {
  /// Acepta el precio propuesto por el empleador (R5.2).
  accept
  /// Contraoferta con otro monto (R5.2).
  counter

  @@map("offer_type")
}

enum OfferStatus {
  activa
  aceptada
  cerrada
  /// El trabajador la retiró antes de que el empleador eligiera (Fase 4).
  retirada

  @@map("offer_status")
}

/// Oferta de un trabajador (R5, ADR-0026). Una por trabajador y solicitud: reemplazarla
/// actualiza la fila y sube `revision`.
model Offer {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String      @map("request_id") @db.Uuid
  workerId  String      @map("worker_id") @db.Uuid
  cityId    String      @map("city_id") @db.Uuid
  type      OfferType
  amountBs  Decimal     @map("amount_bs") @db.Decimal(10, 2)
  /// Tiempo estimado de llegada en minutos (distancia y medio de transporte).
  etaMin    Int         @map("eta_min")
  distanceM Int         @map("distance_m")
  status    OfferStatus @default(activa)
  revision  Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  worker  WorkerProfile  @relation(fields: [workerId], references: [userId], onDelete: Cascade)
  events  OfferEvent[]

  @@unique([requestId, workerId])
  @@index([requestId, status])
  @@map("offers")
}

/// Estados del trabajo (R6.1). En la Fase 3 solo se crea en `asignado`; el resto es de la Fase 4.
/// Motivos de cancelación de un trabajo (lista cerrada, propuesta Fase 4).
enum JobCancelReason {
  cambio_de_planes
  no_llega_o_no_responde
  desacuerdo_de_precio
  emergencia
  otro

  @@map("job_cancel_reason")
}

enum JobStatus {
  asignado
  en_camino
  en_curso
  terminado
  cancelado

  @@map("job_status")
}

enum OfferEventKind {
  creada
  /// El trabajador cambió su oferta (o volvió a enviar una retirada): nuevo monto.
  reemplazada
  retirada
  aceptada
  cerrada

  @@map("offer_event_kind")
}

/// Historial de cada oferta (ADR-0042), append-only (trigger): guarda cada monto ofertado
/// para revisar disputas. Se escribe en la misma transacción que el cambio de la oferta.
model OfferEvent {
  id        BigInt         @id @default(autoincrement())
  offerId   String         @map("offer_id") @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  workerId  String         @map("worker_id") @db.Uuid
  cityId    String         @map("city_id") @db.Uuid
  kind      OfferEventKind
  revision  Int
  type      OfferType
  amountBs  Decimal        @map("amount_bs") @db.Decimal(10, 2)
  etaMin    Int            @map("eta_min")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId, id])
  @@index([requestId, createdAt])
  @@map("offer_events")
}

/// Trabajo asignado al aceptar una oferta (R5.4, ADR-0026).
model Job {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Única: una solicitud tiene a lo sumo un trabajo (segunda barrera contra la doble asignación).
  requestId        String           @unique @map("request_id") @db.Uuid
  workerId         String           @map("worker_id") @db.Uuid
  employerId       String           @map("employer_id") @db.Uuid
  cityId           String           @map("city_id") @db.Uuid
  offerId          String           @unique @map("offer_id") @db.Uuid
  finalPriceBs     Decimal          @map("final_price_bs") @db.Decimal(10, 2)
  /// Copia de la comisión efectiva de la categoría al asignar (CategoryResolver, ADR-0016).
  commissionPct    Decimal          @map("commission_pct") @db.Decimal(5, 2)
  /// Se calcula al terminar: final × pct / 100, HALF_UP a 2 decimales (R6.3, ADR-0030).
  commissionBs     Decimal?         @map("commission_bs") @db.Decimal(10, 2)
  /// Solo lo cambia JobStatusService (ADR-0029).
  status           JobStatus        @default(asignado)
  assignedAt       DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  onTheWayAt       DateTime?        @map("on_the_way_at") @db.Timestamptz(3)
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(3)
  /// El trabajador marcó "Terminé" (solo desde en_curso); arranca la autoconfirmación.
  workerFinishedAt DateTime?        @map("worker_finished_at") @db.Timestamptz(3)
  /// El empleador reportó un problema: sin autoconfirmación; lo resuelve el admin.
  disputedAt       DateTime?        @map("disputed_at") @db.Timestamptz(3)
  disputeNote      String?          @map("dispute_note")
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  autoConfirmed    Boolean          @default(false) @map("auto_confirmed")
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  /// worker | employer | admin (admin = disputa resuelta como cancelada).
  cancelledByRole  String?          @map("cancelled_by_role")
  cancelledById    String?          @map("cancelled_by_id") @db.Uuid
  cancelReason     JobCancelReason? @map("cancel_reason")
  /// Nota opcional, moderada (ADR-0018): si coincide queda retenida y solo la ve quien la escribió.
  cancelNote       String?          @map("cancel_note")
  cancelNoteHeld   Boolean          @default(false) @map("cancel_note_held")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  request  ServiceRequest @relation(fields: [requestId], references: [id])
  worker   User           @relation("JobWorker", fields: [workerId], references: [id])
  employer User           @relation("JobEmployer", fields: [employerId], references: [id])
  events   JobEvent[]
  messages ChatMessage[]
  reviews  Review[]

  /// Además: índice único parcial jobs_one_active_per_worker (migración 20261017020000).
  @@index([workerId, createdAt])
  @@index([employerId, createdAt])
  @@map("jobs")
}

enum ChatMessageStatus {
  entregado
  /// Coincidió con la moderación (R9.2): no se entrega; solo lo ve quien lo envió.
  retenido
  /// El admin lo revisó y no lo entrega (Fase 6). Para quien lo envió sigue como "no enviado".
  descartado

  @@map("chat_message_status")
}

/// Chat del trabajo (ADR-0031): solo texto, moderado mensaje por mensaje.
model ChatMessage {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String            @map("job_id") @db.Uuid
  cityId            String            @map("city_id") @db.Uuid
  senderId          String            @map("sender_id") @db.Uuid
  body              String
  status            ChatMessageStatus
  /// Términos que coincidieron (solo para el admin).
  moderationMatches Json?             @map("moderation_matches")
  /// Lo leyó el destinatario.
  readAt            DateTime?         @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId, createdAt])
  @@index([status, createdAt])
  @@map("chat_messages")
}

enum ReviewerRole {
  employer
  worker

  @@map("reviewer_role")
}

/// Calificaciones (R6.2, ADR-0032): ciegas hasta que califican ambos o vence el plazo.
model Review {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String       @map("job_id") @db.Uuid
  cityId       String       @map("city_id") @db.Uuid
  fromUserId   String       @map("from_user") @db.Uuid
  toUserId     String       @map("to_user") @db.Uuid
  /// Rol de quien califica.
  reviewerRole ReviewerRole @map("reviewer_role")
  /// 1 a 5 (CHECK en la migración).
  stars        Int          @db.SmallInt
  comment      String?
  /// El comentario coincidió con la moderación: no se muestra (las estrellas cuentan).
  commentHeld  Boolean      @default(false) @map("comment_held")
  /// null = todavía ciega.
  publishedAt  DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id])

  @@unique([jobId, fromUserId])
  @@index([toUserId, reviewerRole, publishedAt])
  @@index([publishedAt, createdAt])
  @@map("reviews")
}

enum ReportTargetType {
  request
  user
  chat_message
  job

  @@map("report_target_type")
}

/// Motivos (lista cerrada): los de R9.1 y otros de convivencia (ADR-0033).
enum ReportReason {
  servicios_sexuales
  drogas
  armas
  ilegal
  inmoral
  venta_productos
  acoso
  fraude
  no_se_presento
  suplantacion
  otro

  @@map("report_reason")
}

enum ReportStatus {
  pendiente
  valido
  descartado

  @@map("report_status")
}

/// Reportes (R9.3, ADR-0033). Uno por persona y objetivo.
model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id") @db.Uuid
  /// Dueño del objetivo: a quien cuentan los reportes válidos.
  reportedUserId String           @map("reported_user_id") @db.Uuid
  cityId         String           @map("city_id") @db.Uuid
  reason         ReportReason
  note           String?
  /// La nota coincidió con la moderación (solo informativo para el admin).
  noteHeld       Boolean          @default(false) @map("note_held")
  status         ReportStatus     @default(pendiente)
  resolution     String?
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([reportedUserId, status])
  @@map("reports")
}

/// Historial del trabajo (ADR-0029). Append-only: un trigger rechaza UPDATE y DELETE.
model JobEvent {
  id         BigInt    @id @default(autoincrement())
  jobId      String    @map("job_id") @db.Uuid
  action     String
  fromStatus JobStatus @map("from_status")
  toStatus   JobStatus @map("to_status")
  /// worker | employer | system | admin.
  actorRole  String    @map("actor_role")
  /// null = sistema.
  actorId    String?   @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId, id])
  @@map("job_events")
}

enum LedgerEntryType {
  comision
  pago
  ajuste

  @@map("ledger_entry_type")
}

enum BillingPeriodStatus {
  abierto
  cerrado_pendiente
  pagado
  vencido

  @@map("billing_period_status")
}

/// Periodo semanal de cobro de un trabajador (R7.2, R7.8, ADR-0035). Intervalo [start_at, end_at)
/// en la zona horaria de su ciudad. Los totales son derivados del ledger.
model BillingPeriod {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId         String              @map("worker_id") @db.Uuid
  cityId           String              @map("city_id") @db.Uuid
  timezone         String
  startAt          DateTime            @map("start_at") @db.Timestamptz(3)
  endAt            DateTime            @map("end_at") @db.Timestamptz(3)
  dueAt            DateTime            @map("due_at") @db.Timestamptz(3)
  status           BillingPeriodStatus @default(abierto)
  /// Derivados: suma de los trabajos y de las comisiones del periodo (se verifican contra el ledger).
  grossBs          Decimal             @default(0) @map("gross_bs") @db.Decimal(12, 2)
  commissionBs     Decimal             @default(0) @map("commission_bs") @db.Decimal(12, 2)
  paymentReference String              @unique @map("payment_reference")
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(3)
  paidAt           DateTime?           @map("paid_at") @db.Timestamptz(3)
  overdueAt        DateTime?           @map("overdue_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries  LedgerEntry[]
  notices  BillingNotice[]
  payments Payment[]

  @@unique([workerId, startAt])
  @@index([status, endAt])
  @@index([status, dueAt])
  // Panel: periodos por semana y estado, más nuevos primero (Fase 6).
  @@index([startAt])
  @@index([status, startAt])
  @@map("billing_periods")
}

/// Ledger inmutable (R7.9, ADR-0034). Monto con signo: positivo aumenta la deuda (comisión,
/// ajuste en contra); negativo la reduce (pago, ajuste a favor). Un trigger rechaza UPDATE y DELETE.
model LedgerEntry {
  id              BigInt          @id @default(autoincrement())
  workerId        String          @map("worker_id") @db.Uuid
  cityId          String          @map("city_id") @db.Uuid
  periodId        String          @map("period_id") @db.Uuid
  type            LedgerEntryType
  amountBs        Decimal         @map("amount_bs") @db.Decimal(12, 2)
  /// Comisión: el trabajo (único por trabajo, índice parcial).
  jobId           String?         @map("job_id") @db.Uuid
  /// Pago: el registro de payments.
  paymentId       String?         @map("payment_id") @db.Uuid
  /// Ajuste: el movimiento que corrige, si aplica.
  correctsEntryId BigInt?         @map("corrects_entry_id")
  reason          String?
  /// Quién lo creó (admin); null = sistema.
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  period  BillingPeriod @relation(fields: [periodId], references: [id])
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([workerId, id])
  @@index([periodId])
  @@map("ledger_entries")
}

/// Avisos de cobro ya emitidos por periodo (R7.6): uno por tipo, aunque el cron corra muchas veces.
model BillingNotice {
  periodId  String   @map("period_id") @db.Uuid
  /// cierre | vispera | dia | vencido
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period BillingPeriod @relation(fields: [periodId], references: [id])

  @@id([periodId, kind])
  @@map("billing_notices")
}

enum PaymentMethod {
  qr_transferencia
  efectivo
  otro

  @@map("payment_method")
}

/// Pago registrado por un admin (R7.4, ADR-0037). Se reparte en el ledger: un movimiento
/// `pago` por periodo cubierto, todos con este payment_id.
model Payment {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId       String             @map("worker_id") @db.Uuid
  cityId         String             @map("city_id") @db.Uuid
  /// Primer periodo que cubre (el más antiguo con saldo).
  periodId       String             @map("period_id") @db.Uuid
  amountBs       Decimal            @map("amount_bs") @db.Decimal(12, 2)
  method         PaymentMethod
  /// Referencia que el trabajador escribió en la glosa, o la del banco.
  reference      String?
  /// Comprobante en el bucket privado (receipts/{worker}/…).
  receiptKey     String?            @map("receipt_key")
  /// Número de factura de la comisión: sin uso hasta la revisión tributaria (pendiente).
  invoiceNumber  String?            @map("invoice_number")
  registeredById String             @map("registered_by_id") @db.Uuid
  /// Comprobante enviado por el trabajador que originó este registro, si hubo.
  submissionId   String?            @unique @map("submission_id") @db.Uuid
  submission     PaymentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  paidAt         DateTime           @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  period  BillingPeriod @relation(fields: [periodId], references: [id])
  entries LedgerEntry[]

  @@index([workerId, paidAt])
  @@map("payments")
}

/// Claves de idempotencia de las operaciones de dinero del admin (pagos y ajustes): un
/// reintento con la misma clave devuelve la respuesta original sin repetir el movimiento.
model IdempotencyKey {
  scope       String
  key         String
  actorId     String   @map("actor_id") @db.Uuid
  /// Huella del cuerpo: la misma clave con otro cuerpo se rechaza.
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@map("idempotency_keys")
}

enum PaymentSubmissionStatus {
  pendiente
  registrado
  rechazado

  @@map("payment_submission_status")
}

/// Comprobante subido por el trabajador (propuesta, ADR-0037): "enviado, pendiente de
/// verificación". No toca el ledger hasta que un admin registra el pago.
model PaymentSubmission {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId         String                  @map("worker_id") @db.Uuid
  cityId           String                  @map("city_id") @db.Uuid
  receiptKey       String                  @map("receipt_key")
  declaredAmountBs Decimal?                @map("declared_amount_bs") @db.Decimal(12, 2)
  note             String?
  status           PaymentSubmissionStatus @default(pendiente)
  paymentId        String?                 @map("payment_id") @db.Uuid
  reviewNote       String?                 @map("review_note")
  reviewedById     String?                 @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment?

  @@index([workerId, createdAt])
  @@index([status, createdAt])
  @@map("payment_submissions")
}

/// Configuración editable por el admin (por ahora, el QR de cobro de la empresa).
model AppSetting {
  key         String
  /// 'global' o el id de una ciudad.
  scope       String   @default("global")
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([key, scope])
  @@map("app_settings")
}

/// Auditoría del panel (ADR-0041). Append-only (trigger): toda acción admin que cambia algo
/// deja una fila en la misma transacción del cambio.
model AdminAuditLog {
  id           BigInt   @id @default(autoincrement())
  adminId      String   @map("admin_id") @db.Uuid
  /// área.verbo, p. ej. verification.approve o billing.payment.
  action       String   @db.VarChar(64)
  targetType   String   @map("target_type") @db.VarChar(32)
  targetId     String   @map("target_id") @db.VarChar(64)
  before       Json?
  after        Json?
  reason       String?
  /// IP que vio la API (detrás del proxy del panel, la de Vercel, ADR-0040).
  ip           String?  @db.VarChar(64)
  /// X-Forwarded-For recibido: informativo, no confiable.
  forwardedFor String?  @map("forwarded_for") @db.VarChar(256)
  userAgent    String?  @map("user_agent") @db.VarChar(256)
  cityId       String?  @map("city_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin User  @relation("AdminAuditLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  city  City? @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}
