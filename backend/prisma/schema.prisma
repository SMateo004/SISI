// Esquema de datos de SISI. Ver docs/02-contexto-tecnico-claude-code.md §4 y ADR-0003.
// Nombres en BD en snake_case; montos en Decimal; fechas en UTC (timestamptz).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Ciudades donde opera la plataforma (R10.1: toda entidad relevante lleva city_id).
model City {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  /// Código de país ISO 3166-1 alfa-2 (BO).
  countryCode String   @map("country_code") @db.Char(2)
  /// Zona horaria IANA (America/La_Paz).
  timezone    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("cities")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

/// Modo activo de la cuenta (R1.2: toda cuenta nueva empieza como employer).
enum ActiveMode {
  employer
  worker

  @@map("active_mode")
}

/// Una cuenta por persona, identificada por su teléfono en E.164 (R1.1).
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String     @unique
  name            String?
  /// Clave del objeto en el almacenamiento (avatars/...); la URL se firma al responder.
  photoKey        String?    @map("photo_key")
  role            UserRole   @default(user)
  activeMode      ActiveMode @default(employer) @map("active_mode")
  cityId          String     @map("city_id") @db.Uuid
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  city          City           @relation(fields: [cityId], references: [id])
  refreshTokens RefreshToken[]

  @@index([cityId])
  @@map("users")
}

/// Refresh tokens rotativos (ADR-0009). Se guarda solo el hash; id = jti del JWT.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Todos los tokens de una misma sesión comparten familia; reutilizar uno revoca la familia.
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
